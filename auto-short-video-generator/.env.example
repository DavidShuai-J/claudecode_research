AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_region_here

# Replicate (用于Stable Diffusion等，可选)
REPLICATE_API_TOKEN=your_replicate_token_here

# ============ 其他配置 ============
DEBUG=false
LOG_LEVEL=INFO
