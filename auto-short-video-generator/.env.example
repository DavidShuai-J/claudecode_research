# ============ 扣子(Coze) API（推荐） ============
COZE_ACCESS_TOKEN=cztei_lvae6PbLhkIHRcHkT4xiQ4X8gPfEwXClxFqwZpP7dhfOYuoBeS2khIwDTZJllefQg

# ============ OpenAI API（备选） ============
OPENAI_API_KEY=your_openai_api_key_here
